# Local development settings. Copy to .env. Never commit .env.
# Live settings are set on Render only; never copy them into this file.

# Required. Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The server refuses to start with a key under 32 characters unless FLASK_DEBUG=1.
SECRET_KEY=

# 1 on your own machine: SQLite, photos on disk or in the snug-co-dev Cloudinary folder, no
# Secure cookies, debug pages. The server refuses to start with it on Render.
FLASK_DEBUG=1

# Leave empty for local SQLite (instance/snug.db). A local PostgreSQL works too:
# DATABASE_URL=postgresql://user:password@localhost:5432/snug
# Outside Render, a database on another machine is refused unless ALLOW_REMOTE_DATABASE=1 is set
# for that one command, so local work never reaches the live database by accident.
DATABASE_URL=

# Development only (needs FLASK_DEBUG=1): where photos go when Cloudinary isn't set. Production
# never writes photos to disk; leave these empty on Render.
UPLOAD_DIR=
UPLOAD_URL_BASE=/uploads

# Cloudinary stores every product photo in production (Settings > API Keys in the Cloudinary
# console). Server only: never put these in the client, Vercel or git. Leave empty locally to
# keep photos on disk; if set with FLASK_DEBUG=1, uploads go to snug-co-dev/ and live photos
# are never deleted.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Leave as cloudinary. "legacy" only serves photos stored before Cloudinary (older databases).
IMAGE_DELIVERY=cloudinary

# The client's deployed origin(s), comma separated, when it's hosted on another domain
# than this API (the client on Vercel proxies /api here, so Render sees its own host). The admin checks every
# change request comes from one of these. Leave empty when client and API share a domain.
ALLOWED_ORIGINS=

# Leave as Lax when the client proxies /api to this server (client/vercel.json does).
# Set to None only if the browser calls this API's own domain directly from another site.
SESSION_COOKIE_SAMESITE=Lax

# Number of reverse proxies in front of the app (for correct client IPs and HTTPS detection).
TRUSTED_PROXIES=0

# Optional. Overrides the live site URL used in robots.txt's Sitemap line and sitemap.xml's
# <loc> entries. Falls back to VITE_SITE_URL, then to the request's own host, so this is only
# needed if the API's site URL should differ from the client's.
SITE_URL=

# Optional. Where this server looks for the built client (index.html, assets) to serve when it
# handles the site directly instead of Vercel. Defaults to ../client/dist; only set this if the
# built client lives somewhere else.
CLIENT_DIST=
